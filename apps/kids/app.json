{
  "expo": {
    "name": "Turnip",
    "slug": "turnip-kids",
    "owner": "sarahbuildsapps",
    "version": "1.0.0",
    "scheme": "turnip",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.turniplearning",
      "supportsTablet": true,
      "icon": "./assets/turnip.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/mascot.png",
          "imageWidth": 220,
          "backgroundColor": "#F6F5FB"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/FrauncesSoft-SemiBold.ttf",
            "./assets/fonts/DMSans-Regular.ttf",
            "./assets/fonts/DMSans-Medium.ttf",
            "./assets/fonts/DMSans-SemiBold.ttf",
            "./assets/fonts/DMSans-Bold.ttf"
          ]
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-screen-orientation",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "d1ccbda1-5ca4-40ee-8368-24d68d708c4f"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
