# Mux
# Your Mux environment key for Mux Data analytics (found in Mux dashboard → Environments)
EXPO_PUBLIC_MUX_ENV_KEY=your_mux_env_key_here

# Firebase
# Copy these values from your Firebase project → Project Settings → General → Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:ios:abc123

# Optional: Mux signed playback token secret (for private videos — server-side only, never in the app)
# MUX_TOKEN_ID=your_mux_token_id
# MUX_TOKEN_SECRET=your_mux_token_secret
