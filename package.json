{
  "name": "turnip-learning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "kids": "pnpm --filter @turnip/kids start",
    "ios": "pnpm --filter @turnip/kids ios",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .prettierignore",
    "samples": "http-server artifacts/TurnipAppSampleVideo -p 8765 -c-1 --cors"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "http-server": "^14.1.1"
  }
}
